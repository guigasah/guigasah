# ===== AliExpress Affiliate (https://openservice.aliexpress.com) =====
ALI_APP_KEY=
ALI_APP_SECRET=
# seu tracking id do portals.aliexpress.com
ALI_TRACKING_ID=

# Busca
SEARCH_KEYWORDS=resina 3d,resina uv 405nm,resina lavavel em agua,resina abs like,resina elegoo,resina anycubic
MAX_PRICE_BRL=250
# % mínimo de desconto
MIN_DISCOUNT=20
# % avaliação positiva mínima (0 = ignora)
MIN_RATING=90
# vendas recentes mínimas
MIN_SALES=10
POSTS_PER_RUN=3
# reposta o mesmo produto só depois de X dias (ou se o preço cair)
REPOST_AFTER_DAYS=7

# ===== WhatsApp via Evolution API (https://doc.evolution-api.com) =====
# dryrun | evolution
WHATSAPP_PROVIDER=dryrun
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=promo
# Destinos separados por vírgula: grupos (...@g.us) e/ou canal (...@newsletter)
WHATSAPP_TARGETS=
# segundos (evita bloqueio por spam)
DELAY_BETWEEN_TARGETS=8

# ===== Sua marca (vai no card e na mensagem) =====
BRAND_NAME=FORJA NERD
BRAND_SITE=forjanerd.com.br
BRAND_HASHTAG="#forjanerd"
BRAND_COLOR="#E60012"
GROUPS_LINK=https://chat.whatsapp.com/SEU_LINK
# Se existir assets/moldura.png (sua arte pronta), o produto é colado dentro dela:
# área da foto em pixels: x1,y1,x2,y2 (vazio = centro da arte)
CARD_PHOTO_BOX=
# escreve preço na arte
CARD_SHOW_PRICE=true
# miniaturas de outras fotos do anúncio ao lado da foto principal
CARD_THUMBS=true
# quantas fotos extras do anúncio enviar depois do post (0 = nenhuma)
EXTRA_PHOTOS=0

# ===== Texto com IA (opcional) =====
USE_AI_COPY=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Agendamento (modo loop)
INTERVAL_MINUTES=120
# não posta entre 23h e 8h
QUIET_HOURS=23-8
