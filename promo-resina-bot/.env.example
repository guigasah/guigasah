# ===== AliExpress Affiliate (https://openservice.aliexpress.com) =====
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=          # seu tracking id do portals.aliexpress.com

# Busca
SEARCH_KEYWORDS=resina 3d,resina uv 405nm,resina lavavel em agua,resina abs like,resina elegoo,resina anycubic
MAX_PRICE_BRL=250
MIN_DISCOUNT=20           # % mínimo de desconto
MIN_RATING=90             # % avaliação positiva mínima (0 = ignora)
MIN_SALES=10              # vendas recentes mínimas
POSTS_PER_RUN=3
REPOST_AFTER_DAYS=7       # reposta o mesmo produto só depois de X dias (ou se o preço cair)

# ===== WhatsApp via Evolution API (https://doc.evolution-api.com) =====
WHATSAPP_PROVIDER=dryrun  # dryrun | evolution
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=promo
# Destinos separados por vírgula: grupos (...@g.us) e/ou canal (...@newsletter)
WHATSAPP_TARGETS=
DELAY_BETWEEN_TARGETS=8   # segundos (evita bloqueio por spam)

# ===== Sua marca (vai no card e na mensagem) =====
BRAND_NAME=FORJA NERD
BRAND_SITE=forjanerd.com.br
BRAND_HASHTAG=#forjanerd
BRAND_COLOR=#E60012
GROUPS_LINK=https://chat.whatsapp.com/SEU_LINK
# Se existir assets/moldura.png (sua arte pronta), o produto é colado dentro dela:
CARD_PHOTO_BOX=           # área da foto em pixels: x1,y1,x2,y2 (vazio = centro da arte)
CARD_SHOW_PRICE=true      # escreve preço na arte

# ===== Texto com IA (opcional) =====
USE_AI_COPY=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Agendamento (modo loop)
INTERVAL_MINUTES=120
QUIET_HOURS=23-8          # não posta entre 23h e 8h
